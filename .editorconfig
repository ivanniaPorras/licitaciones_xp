root = true

[*]
charset = utf-8
# LF en todo el repositorio: la integración continua verifica el formato sobre Linux
# y el mismo archivo debe pasar la verificación en ambos sistemas operativos.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,cshtml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Organización de directivas using
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Espacios de nombres con ámbito de archivo
csharp_style_namespace_declarations = file_scoped:warning

# Preferencias de lenguaje
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Modificadores
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning
dotnet_style_readonly_field = true:warning

# Calidad
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# Convenciones de nombres
dotnet_naming_rule.tipos_pascal_case.severity = warning
dotnet_naming_rule.tipos_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_pascal_case.style = pascal_case
dotnet_naming_symbols.tipos.applicable_kinds = class,struct,interface,enum,delegate,method,property,event,namespace
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.interfaces_prefijo_i.severity = warning
dotnet_naming_rule.interfaces_prefijo_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefijo_i.style = prefijo_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefijo_i.required_prefix = I
dotnet_naming_style.prefijo_i.capitalization = pascal_case

# Los campos estáticos de solo lectura son constantes de hecho y usan PascalCase.
# Esta regla debe declararse antes que la de campos de instancia: se aplica la primera
# regla cuyo grupo de símbolos coincida.
dotnet_naming_rule.campos_estaticos_pascal_case.severity = warning
dotnet_naming_rule.campos_estaticos_pascal_case.symbols = campos_privados_estaticos
dotnet_naming_rule.campos_estaticos_pascal_case.style = pascal_case
dotnet_naming_symbols.campos_privados_estaticos.applicable_kinds = field
dotnet_naming_symbols.campos_privados_estaticos.applicable_accessibilities = private
dotnet_naming_symbols.campos_privados_estaticos.required_modifiers = static,readonly

dotnet_naming_rule.campos_privados_guion_bajo.severity = warning
dotnet_naming_rule.campos_privados_guion_bajo.symbols = campos_privados
dotnet_naming_rule.campos_privados_guion_bajo.style = guion_bajo_camel_case
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.guion_bajo_camel_case.required_prefix = _
dotnet_naming_style.guion_bajo_camel_case.capitalization = camel_case

# Los proyectos de prueba no exigen documentación XML en cada miembro público
[tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
