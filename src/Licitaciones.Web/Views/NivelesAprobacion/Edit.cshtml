@using Licitaciones.Application.Aprobacion
@model ActualizarNivelAprobacionRequest
@{
    ViewData["Title"] = "Editar nivel de aprobación";
    var id = (Guid)ViewData["Id"]!;
}

<h1>Editar nivel de aprobación</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" asp-action="Edit" asp-route-id="@id" class="col-md-8">
    <div class="mb-3">
        <label class="form-label" for="MontoMinimoCRC">Monto mínimo (CRC)</label>
        <input class="form-control" id="MontoMinimoCRC" name="MontoMinimoCRC"
               type="number" step="0.01" min="0.01" inputmode="decimal" required
               value="@Model.MontoMinimoCRC.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <span asp-validation-for="MontoMinimoCRC" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="MontoMaximoCRC">Monto máximo (CRC)</label>
        <input class="form-control" id="MontoMaximoCRC" name="MontoMaximoCRC"
               type="number" step="0.01" min="0.01" inputmode="decimal"
               value="@Model.MontoMaximoCRC?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <div class="form-text">Déjelo vacío para un rango sin límite superior.</div>
        <span asp-validation-for="MontoMaximoCRC" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="Aprobador">Aprobador</label>
        <input class="form-control" id="Aprobador" name="Aprobador" value="@Model.Aprobador"
               required maxlength="100" />
        <span asp-validation-for="Aprobador" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
