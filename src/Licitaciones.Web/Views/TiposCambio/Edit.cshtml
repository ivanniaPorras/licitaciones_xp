@using Licitaciones.Application.Moneda
@model ActualizarTipoCambioRequest
@{
    ViewData["Title"] = "Editar tipo de cambio";
    var id = (Guid)ViewData["Id"]!;
}

<h1>Editar tipo de cambio</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" asp-action="Edit" asp-route-id="@id" class="col-md-8">
    <div class="mb-3">
        <label class="form-label" for="CRCporUSD">Colones por dólar</label>
        <input class="form-control" id="CRCporUSD" name="CRCporUSD"
               type="number" step="0.0001" min="0.0001" inputmode="decimal" required
               value="@Model.CRCporUSD.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <span asp-validation-for="CRCporUSD" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="FechaVigencia">Fecha de vigencia</label>
        <input class="form-control" id="FechaVigencia" name="FechaVigencia" type="date" required
               value="@Model.FechaVigencia.ToLocalTime().ToString("yyyy-MM-dd")" />
        <span asp-validation-for="FechaVigencia" class="text-danger"></span>
    </div>

    <div class="form-text mb-3">
        Editar la tasa no cambia cuál está en uso. Los montos guardados siguen expresados
        en colones.
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
