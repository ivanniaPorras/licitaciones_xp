@using Licitaciones.Application.Comun
@using Licitaciones.Application.Moneda
@using Licitaciones.Web.Vistas
@model PagedResponse<TipoCambioResponse>
@{
    ViewData["Title"] = "Tipo de cambio";
}

<h1>Tipo de cambio</h1>
<partial name="_Mensajes" />

<p class="text-muted">
    Los montos se guardan siempre en colones. La tasa vigente solo sirve para leerlos
    también en dólares y nunca modifica lo almacenado. El sistema no consulta ningún
    servicio externo de tasas.
</p>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-auto">
        <label class="visually-hidden" for="busqueda">Buscar por año de vigencia</label>
        <input type="search" class="form-control" id="busqueda" name="busqueda"
               value="@Context.Request.Query["busqueda"]" placeholder="Año, por ejemplo 2026" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="col-auto ms-auto">
        <a class="btn btn-primary" asp-action="Create">Agregar tipo de cambio</a>
    </div>
</form>

@if (Model is null || Model.Elementos.Count == 0)
{
    <p class="text-muted">No hay tipos de cambio que coincidan con la búsqueda.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption>@Model.Total tipos de cambio registrados</caption>
            <thead>
                <tr>
                    <partial name="_ColumnaOrdenable" model="@(new ColumnaOrdenable("tasa", "Colones por dólar"))" />
                    <partial name="_ColumnaOrdenable" model="@(new ColumnaOrdenable("vigencia", "Vigente desde", "Index", "desc"))" />
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var tipoCambio in Model.Elementos)
            {
                <tr>
                    <td>@tipoCambio.CRCporUSD.ToString("N4")</td>
                    <td>@tipoCambio.FechaVigencia.UtcDateTime.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (tipoCambio.Activo)
                        {
                            <span class="badge bg-success">En uso</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Fuera de uso</span>
                        }
                    </td>
                    <td>
                        @if (!tipoCambio.Activo)
                        {
                            <form method="post" asp-action="Activar" asp-route-id="@tipoCambio.Id" class="d-inline"
                                  onsubmit="return confirm('¿Confirma poner esta tasa en uso? La que está vigente dejará de usarse.');">
                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@tipoCambio.Id">Ver</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@tipoCambio.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@tipoCambio.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" model="@((Model.Pagina, Model.TotalPaginas, "Index"))" />
}
