@using System.Collections.Immutable
@using Licitaciones.Application.Licitaciones
@using Licitaciones.Domain.Licitaciones
@model LicitacionResponse
@{
    ViewData["Title"] = Model.Codigo;
    var transiciones = (ImmutableArray<EstadoLicitacion>)ViewData["Transiciones"]!;
}

<h1>@Model.Codigo — @Model.Titulo</h1>
<partial name="_Mensajes" />

<dl class="row">
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        <span class="badge bg-secondary">@Model.Estado</span>
        @if (Model.CerradaFuncionalmente && Model.Estado != EstadoLicitacion.Cerrada)
        {
            <span class="badge bg-warning text-dark">
                Vencida: la fecha de cierre ya pasó, así que no admite más ofertas
            </span>
        }
    </dd>

    <dt class="col-sm-3">Presupuesto estimado</dt>
    <dd class="col-sm-9" data-crc="@Model.PresupuestoEstimadoCRC.ToString(System.Globalization.CultureInfo.InvariantCulture)">
        @Model.PresupuestoEstimadoCRC.ToString("C2")
    </dd>

    <dt class="col-sm-3">Fecha de cierre</dt>
    <dd class="col-sm-9">@Model.FechaCierre.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Ofertas recibidas</dt>
    <dd class="col-sm-9">@Model.CantidadOfertas</dd>
</dl>

@if (transiciones.Length > 0)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Cambiar estado</h2>
            <p class="card-text text-muted">
                Desde @Model.Estado solo se admiten estas transiciones.
            </p>
            @foreach (var destino in transiciones)
            {
                <form method="post" asp-action="CambiarEstado" asp-route-id="@Model.Id" class="d-inline"
                      onsubmit="return confirm('¿Confirma pasar la licitación a @destino?');">
                    <input type="hidden" name="estado" value="@destino" />
                    <button type="submit" class="btn btn-outline-primary">Pasar a @destino</button>
                </form>
            }
        </div>
    </div>
}
else
{
    <p class="text-muted">
        La licitación está cerrada. Es un estado final: no admite ninguna transición posterior.
    </p>
}

<a class="btn btn-outline-secondary" asp-action="Ofertas" asp-route-id="@Model.Id">Ver ofertas y mejor oferta</a>
@if (Model.Estado != EstadoLicitacion.Cerrada)
{
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
}
<a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a>
<a class="btn btn-link" asp-action="Index">Volver</a>
