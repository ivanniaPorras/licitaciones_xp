@inject Microsoft.Extensions.Configuration.IConfiguration Configuracion
@{
    var urlDocumentacion = Configuracion["Api:UrlDocumentacion"];
}
<!DOCTYPE html>
<html lang="es-CR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Gestión de Licitaciones</title>
    @* El tema se resuelve antes de pintar para que la página no parpadee con el equivocado. *@
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Licitaciones.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Licitaciones</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Mostrar u ocultar la navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarPrincipal">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Licitaciones" asp-action="Index">Licitaciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Proveedores" asp-action="Index">Proveedores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Ofertas" asp-action="Index">Ofertas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="NivelesAprobacion" asp-action="Index">Niveles de aprobación</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="TiposCambio" asp-action="Index">Tipo de cambio</a>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(urlDocumentacion))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@urlDocumentacion" target="_blank" rel="noopener">
                                    Documentación de la API
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <vc:alternador-moneda></vc:alternador-moneda>
                        <partial name="_AlternadorTema" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-3" aria-live="polite">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            Universidad Técnica Nacional &middot; ITI-822 Metodologías Ágiles de Desarrollo de Software
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
