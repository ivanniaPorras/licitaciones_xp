<div class="btn-group btn-group-sm" role="group" id="alternador-tema"
     aria-label="Tema de la interfaz">
    <button type="button" class="btn btn-outline-secondary" data-tema="light" aria-pressed="false">
        <span aria-hidden="true">☀</span>
        <span class="visually-hidden">Tema claro</span>
    </button>
    <button type="button" class="btn btn-outline-secondary" data-tema="dark" aria-pressed="false">
        <span aria-hidden="true">☾</span>
        <span class="visually-hidden">Tema oscuro</span>
    </button>
</div>
