@using Licitaciones.Application.Proveedores
@model CrearProveedorRequest
@{
    ViewData["Title"] = "Registrar proveedor";
}

<h1>Registrar proveedor</h1>

<form method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label" for="Nombre">Nombre</label>
        <input class="form-control" id="Nombre" name="Nombre" value="@Model.Nombre"
               required maxlength="200" pattern="^[\p{L}\p{N} .,\(\)]+$"
               aria-describedby="ayudaNombre" />
        <div id="ayudaNombre" class="form-text">
            Se admiten letras, números, espacios, punto, coma y paréntesis.
        </div>
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
