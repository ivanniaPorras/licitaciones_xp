@using Licitaciones.Application.Proveedores
@model ActualizarProveedorRequest
@{
    ViewData["Title"] = "Editar proveedor";
    var id = (Guid)ViewData["Id"]!;
}

<h1>Editar proveedor</h1>

<form method="post" asp-action="Edit" asp-route-id="@id" class="col-md-6">
    <div class="mb-3">
        <label class="form-label" for="Nombre">Nombre</label>
        <input class="form-control" id="Nombre" name="Nombre" value="@Model.Nombre"
               required maxlength="200" pattern="^[\p{L}\p{N} .,\(\)]+$" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@id">Cancelar</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
