@using Licitaciones.Application.Ofertas
@model OfertaResponse
@{
    ViewData["Title"] = "Oferta";
}

<h1>Oferta de @Model.NombreProveedor</h1>
<partial name="_Mensajes" />

<dl class="row">
    <dt class="col-sm-3">Licitación</dt>
    <dd class="col-sm-9">@Model.CodigoLicitacion</dd>

    <dt class="col-sm-3">Proveedor</dt>
    <dd class="col-sm-9">@Model.NombreProveedor</dd>

    <dt class="col-sm-3">Monto ofertado</dt>
    <dd class="col-sm-9" data-crc="@Model.MontoOfertadoCRC.ToString(System.Globalization.CultureInfo.InvariantCulture)">
        @Model.MontoOfertadoCRC.ToString("C2")
    </dd>

    <dt class="col-sm-3">Fecha de registro</dt>
    <dd class="col-sm-9">@Model.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a>
<a class="btn btn-link" asp-action="Index">Volver</a>

<p class="text-muted mt-3">
    Si la licitación ya cerró, editar y eliminar se rechazan: la oferta queda como
    evidencia inalterable del proceso.
</p>
